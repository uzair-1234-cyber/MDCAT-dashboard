# ==============================================================================
# MediPrep AI - Environment Variables Reference
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (AI Tutor, MCQ Generator, Past Papers AI).
# - In AI Studio: Configured in the Secrets panel.
# - On Vercel: Set in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. https://your-project.vercel.app).
# - Automatically injected in AI Studio.
# - On Vercel: Set to your Vercel deployment URL.
APP_URL="MY_APP_URL"

# MONGODB_URI: External MongoDB Atlas connection string for persistent cloud storage.
# - Required on Vercel for long-term data persistence across serverless invocations.
# - Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studypannel?retryWrites=true&w=majority
# - If not configured, the app operates gracefully in memory / /tmp store.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/studypannel"

# NODE_ENV: 'development' or 'production' (automatically managed by Vercel / runtime)
NODE_ENV="production"

# ==============================================================================
# CLOUDINARY MEDIA STORAGE (Optional / Highly Recommended on Deployment)
# ==============================================================================
# Permanent CDN cloud storage for uploaded past paper scans, diagrams, PDFs, and notes.
# Free signup at: https://cloudinary.com (Includes 25GB free monthly bandwidth/storage).
# Copy these 3 values from your Cloudinary Dashboard:
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

# Or alternative single connection URL:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

